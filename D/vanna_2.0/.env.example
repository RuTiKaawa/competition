# Optional server-wide fallback. The app also starts without this value; each user
# can validate and save a personal Key from /settings. Never expose it in HTML/JS.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional fixed Fernet key for stable multi-instance deployments. When omitted, a
# local 0600 key is generated under .vanna_data/ (which is ignored by Git).
VANNA_CREDENTIAL_ENCRYPTION_KEY=

# Paths are resolved relative to this repository. Chinook is optional: an existing
# valid file is auto-registered, or users can download the example from /settings.
VANNA_CHINOOK_PATH=./Chinook.sqlite
VANNA_WORKING_DIRECTORY=./.vanna_data
