# ── LLM 配置 ──
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192

# ── 服务配置 ──
SERVER_HOST=127.0.0.1
SERVER_PORT=5173

# ── PostgreSQL 数据库配置 ──
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ── 前端静态文件路径 (可留空，默认使用 ./static) ──
# UI_DIR=/path/to/static
